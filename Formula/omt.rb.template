class Omt < Formula
  desc "Local-first financial research terminal"
  homepage "https://github.com/MuhammedZohaib/open-market-terminal"
  version "__VERSION__"
  license "MIT"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/MuhammedZohaib/open-market-terminal/releases/download/v#{version}/omt-v#{version}-aarch64-apple-darwin.tar.gz"
      sha256 "__SHA256_MACOS_ARM64__"
    else
      url "https://github.com/MuhammedZohaib/open-market-terminal/releases/download/v#{version}/omt-v#{version}-x86_64-apple-darwin.tar.gz"
      sha256 "__SHA256_MACOS_X86_64__"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/MuhammedZohaib/open-market-terminal/releases/download/v#{version}/omt-v#{version}-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "__SHA256_LINUX_ARM64__"
    else
      url "https://github.com/MuhammedZohaib/open-market-terminal/releases/download/v#{version}/omt-v#{version}-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "__SHA256_LINUX_X86_64__"
    end
  end

  def install
    bin.install "omt"
    doc.install "README.md", "THIRD_PARTY_NOTICES.md"
    (etc/"omt").install "examples/config.toml" if File.exist?("examples/config.toml")
  end

  test do
    assert_match "Local-first financial research terminal", shell_output("#{bin}/omt --help")
  end
end
