# Copy to .env in the project root. Existing environment variables take priority.
# Alpaca IEX requires both credentials from your Alpaca account.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Optional FRED economic data key.
FRED_API_KEY=

# Optional SEC contact: app name and a real maintained contact email.
